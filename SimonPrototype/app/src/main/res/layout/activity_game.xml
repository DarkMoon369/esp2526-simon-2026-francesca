<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootGame"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- griglia 3x2 -->
    <GridLayout
        android:id="@+id/gridColors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="3"
        android:columnCount="2"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/txtLog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn1"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:backgroundTint="@color/red"
            android:contentDescription="@string/desc_red" /> <!-- rosso -->

        <Button
            android:id="@+id/btn2"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:backgroundTint="@color/green"
            android:contentDescription="@string/desc_green" /> <!-- verde -->

        <Button
            android:id="@+id/btn3"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:backgroundTint="@color/blue"
            android:contentDescription="@string/desc_blue" /> <!-- blu -->

        <Button
            android:id="@+id/btn4"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:backgroundTint="@color/yellow"
            android:contentDescription="@string/desc_yellow" /> <!-- giallo -->

        <Button
            android:id="@+id/btn5"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:backgroundTint="@color/magenta"
            android:contentDescription="@string/desc_magenta" /> <!-- magenta -->

        <Button
            android:id="@+id/btn6"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:backgroundTint="@color/cyan"
            android:contentDescription="@string/desc_cyan" /> <!-- ciano -->


    </GridLayout>

    <!-- Testo multiriga -->
    <TextView
        android:id="@+id/txtLog"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:padding="12dp"
        android:background="#EEEEEE"
        android:textColor="#000000"
        android:textSize="16sp"
        android:text="@string/log_partita"
        android:gravity="top"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/gridColors"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- pulsanti -->
    <GridLayout
        android:id="@+id/controlsGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/avvia"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/pausa"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnResume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/riprendi"
            android:enabled="false"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnEnd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="@string/fine"
            android:minHeight="48dp" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>